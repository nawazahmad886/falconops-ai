# FalconOps AI — repo-root .env
# Used ONLY by docker-compose.yml's variable substitution (the mongo/redis
# containers' credentials). This is separate from backend/.env, which holds the
# application's own config (JWT secret, LLM keys, CORS, etc.) — see
# backend/.env.example if one exists, or install.sh/install-rhel.sh which
# generate it automatically.
#
# install.sh and install-rhel.sh generate this file automatically with random
# values — you only need to fill this in by hand if you're setting up
# docker-compose manually without either script.

# Copy to ".env" (same directory as docker-compose.yml) and fill in real values:
#   cp .env.example .env
#   openssl rand -hex 24   # run twice, once per password below

MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=
